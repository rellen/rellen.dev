name:               rellen-dev
version:            0.1.0.0
build-type:         Simple
cabal-version:      >= 1.10

executable site
  main-is:          site.hs
  hs-source-dirs:   ., src
  other-modules:    Site.Talks
  build-depends:    base == 4.*
                  , hakyll == 4.17.*
                  , dhall >= 1.40
                  , filepath >= 1.4
                  , text >= 2.0
                  , pandoc >= 3.12
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  default-language: Haskell2010
